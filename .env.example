# BOBI environment variables — copy to .env and fill in real values
# NEVER commit .env — it is in .gitignore

# Deployment environment: development | production | test
BOBI_ENV=development

# Log level: debug | info | warn | error
# Output is one JSON object per line. Credential shapes are redacted automatically.
BOBI_LOG_LEVEL=info

# Telegram Bot API token — get from @BotFather
# Keep this secret. Do not commit.
TELEGRAM_BOT_TOKEN=

# Owner identity — the numeric Telegram user id of the owner.
# Required. Must be a positive integer (e.g. 123456789); no letters, dots,
# signs, or whitespace. A username, name, or chat id must NOT be used here.
# If unset or invalid, BOBI refuses to start rather than run with
# administrative access that cannot be trusted.
# Get your own id from @userinfobot.
OWNER_TELEGRAM_ID=

# SQLite file path for persistence. ":memory:" disables persistence.
BOBI_DB_PATH=data/bobi.db

# IANA timezone used for the agent's notion of "now" and for reminders.
BOBI_TIMEZONE=Asia/Tehran

# AI provider (fake until a real one is configured)
AI_MODEL=fake-echo
AI_TIMEOUT_MS=30000
AI_MAX_CONCURRENT=4

# Master key for encrypting AI provider and search credentials (AES-256-GCM).
# Required only when you want to store a real provider's API key. Without it,
# credential writes fail closed and no key is stored in plaintext.
# Accepts 64 hex characters, or any passphrase (a 256-bit key is derived).
# Generate one with:  openssl rand -hex 32
# NEVER commit the real value. Keep it out of the database and logs.
BOBI_AI_KEY_MASTER_KEY=

# ---- Agent budgets ----
# One user message is no longer one model call: the agent may run tools and
# loop. These caps bound what a single message can spend.

# Model turns per message, including the first.
BOBI_AGENT_MAX_ITERATIONS=6

# Tool executions per message, across all turns.
BOBI_AGENT_MAX_TOOL_CALLS=12

# Wall-clock ceiling for a whole run, ms.
BOBI_AGENT_TOTAL_TIMEOUT_MS=120000

# Extra instructions appended to the system prompt. Optional.
BOBI_EXTRA_SYSTEM_PROMPT=

# Directory of owner-authored skill files (markdown with frontmatter), matched
# against each user message and pasted into the system prompt.
#
# SECURITY: this directory is an owner-only configuration surface, like .env.
# Only the server owner should have write access; skill bodies must never
# contain secrets. See docs/phase-a3-skills.md.
BOBI_SKILLS_DIR=./skills

# ---- Rate limits (per user) ----
# The owner is exempt. Set to 0 to disable a rule.

# Messages per minute.
BOBI_RATE_LIMIT_PER_MINUTE=20

# Tool executions per hour. This bounds what the MODEL can trigger on a user's
# behalf, which is the figure that grows when a model loops.
BOBI_RATE_LIMIT_TOOL_CALLS_PER_HOUR=200

# ---- Web search ----
# The default provider needs no key. A keyed provider (Tavily) can be selected
# from /ai, and its key is encrypted with BOBI_AI_KEY_MASTER_KEY like any other.
BOBI_ENABLE_WEB_SEARCH=true

# ---- Reminders ----
# How often the scheduler checks for due reminders, ms.
BOBI_SCHEDULER_INTERVAL_MS=30000

# ---- MCP (Model Context Protocol) ----
# Path to the MCP server config file. Omit or leave missing to disable MCP.
#
# SECURITY: a stdio MCP server is a SHELL COMMAND that runs with this bot's
# authority. Only the owner defines servers, and a server is inert until its
# entry says "enabled": true. See the README for the file format.
BOBI_MCP_CONFIG=mcp.json

# ---- Hosting (Railway, Fly, any container platform) ----
# Port for the health endpoint. A platform decides whether a deploy is alive by
# polling a URL, and a long-polling bot has no socket for it to reach.
#
# The platform's own PORT variable is used automatically when set, so this is
# only needed when the platform does not provide one. Leave unset for a local
# run: no socket is opened at all.
BOBI_HEALTH_PORT=

# ---- Voice transcription (Whisper-style, OpenAI-compatible) ----
# Voice notes are transcribed only when the active provider has no native
# audio input (Gemini does; Anthropic/OpenAI-compatible do not). Any
# OpenAI-compatible /audio/transcriptions endpoint works. Leave the base URL
# empty to disable: voice notes then fall back to the adapter's text note.
BOBI_TRANSCRIBE_BASE_URL=
BOBI_TRANSCRIBE_API_KEY=
BOBI_TRANSCRIBE_MODEL=whisper-1

# ---- Text-to-speech (OpenAI-compatible /audio/speech) ----
# Powers /voice replies. Leave the base URL empty to disable.
BOBI_TTS_BASE_URL=
BOBI_TTS_API_KEY=
BOBI_TTS_MODEL=tts-1
BOBI_TTS_VOICE=alloy

# ---- Image generation (OpenAI-compatible /images/generations) ----
# Powers the generate_image tool. Leave the base URL empty to disable.
BOBI_IMAGE_BASE_URL=
BOBI_IMAGE_API_KEY=
BOBI_IMAGE_MODEL=dall-e-3

# ---- Long-term memory backend (Phase D2) ----
# Which MemoryProvider the remember/recall/forget tools use. "sqlite"
# (default) keeps memories in the bot database; a custom provider registered
# via registerMemoryProvider() in src/memory/registry.ts is selected by its
# name here. Read directly from the environment, not from config.ts.
BOBI_MEMORY_PROVIDER=sqlite
